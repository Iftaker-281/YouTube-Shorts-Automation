    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nif (!item.imagePrompts || !Array.isArray(item.imagePrompts) || item.imagePrompts.length === 0) {\n  throw new Error('Split Image Prompts Error: No imagePrompts array received to split.');\n}\n\nreturn item.imagePrompts.map((prompt, idx) => ({\n  json: {\n    sceneIndex: idx + 1,\n    prompt: typeof prompt === 'object' ? (prompt.text || JSON.stringify(prompt)) : prompt,\n    runId: item.runId,\n    title: item.title || '',\n    script: item.script || ''\n  }\n}));"
