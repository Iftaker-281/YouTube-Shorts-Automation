          "cachedResultName": "models/gemini-3.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a professional YouTube Shorts content creator.\n\nCreate a complete 30-second YouTube Short based on the topic below.\n\nTopic: {{ $json.niche }}\nLanguage: English\nDuration: 30 seconds\nScene_count: 5\n\nThe video must contain EXACTLY 5 scenes. Each scene must be approximately 6 seconds.\n\nCreate:\n1. A YouTube title (under 70 chars)\n2. A 30-second narration/script. Plain spoken text only, no scene labels like [Scene 1], no emojis.\n3. Five stock-photo search queries, one per scene, in the same order as the script\n4. YouTube description with 3 hashtags\n5. YouTube tags (array of 6 tags)\n\nIMPORTANT REQUIREMENTS:\n- Use real, well-known places that actually exist in the topic location.\n- Exactly 5 items in the \"imagePrompts\" array.\n- Each item in \"imagePrompts\" is a SHORT real-photo search query (3 to 6 words, English) naming the real place shown in that scene, for example \"Inani Beach Cox's Bazar\" or \"Himchari waterfall Bangladesh\". Always include the country or city name. If a place is very obscure, use a broader query such as \"Cox's Bazar beach sunset\". No sentences, no styling words.\n- The first scene is a strong hook and the last scene a memorable ending.\n- Keep the story factual and high engagement.\n\nCRITICAL: Return ONLY a valid JSON object. No markdown code blocks, no intro, no outro text. Use EXACTLY this JSON structure:\n\n{\n  \"title\": \"Your catchy title here\",\n  \"description\": \"Your video description with #hashtags\",\n  \"script\": \"Full 30-second voiceover script text here\",\n  \"tags\": [\"tag1\", \"tag2\", \"tag3\", \"tag4\", \"tag5\", \"tag6\"],\n  \"imagePrompts\": [\n    \"photo search query for scene 1\",\n    \"photo search query for scene 2\",\n    \"photo search query for scene 3\",\n    \"photo search query for scene 4\",\n    \"photo search query for scene 5\"\n  ]\n}"
            }
          ]
        },
        "simplify": false,
        "builtInTools": {},
        "options": {}
      },
      "id": "9181e7b5-5fec-4639-8d0e-008e26f5c774",
      "name": "Gemini Content Generator",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        320,
        -688
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\n\nlet config = {};\ntry {\n  config = $('Config: Niche & Template').first().json;\n} catch (e) {\n  config = {};\n}\n\nlet parsed = {};\nlet rawText = '';\n\nif (inputData.candidates && inputData.candidates[0]?.content?.parts[0]?.text) {\n  rawText = inputData.candidates[0].content.parts[0].text;\n} else if (typeof inputData.text === 'string') {\n  rawText = inputData.text;\n} else if (inputData.output) {\n  rawText = typeof inputData.output === 'string' ? inputData.output : JSON.stringify(inputData.output);\n} else {\n  parsed = inputData;\n}\n\nif (rawText) {\n  try {\n    const cleanText = rawText.replace(/```json|```/g, '').trim();\n    parsed = JSON.parse(cleanText);\n  } catch (e) {\n    parsed = inputData;\n  }\n}\n\nlet prompts = parsed.imagePrompts || parsed.image_prompts || parsed.prompts;\n\nif (!prompts && Array.isArray(parsed.scenes)) {\n  prompts = parsed.scenes.map(s => typeof s === 'string' ? s : (s.image_prompt || s.imagePrompt || s.prompt || s.visual));\n}\n\nif (!prompts || !Array.isArray(prompts) || prompts.length === 0) {\n  throw new Error('Gemini Output Processing Error: imagePrompts array not found. Extracted data: ' + JSON.stringify(parsed));\n}\n\nreturn [{\n  json: {\n    ...parsed,\n    imagePrompts: prompts,\n    runId: Date.now().toString(),\n    creatomateTemplateId: config.creatomateTemplateId || '',\n    youtubePrivacyStatus: config.youtubePrivacyStatus || 'public'\n  }\n}];"
      },
