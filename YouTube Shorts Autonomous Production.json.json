    {
      "parameters": {
        "jsCode": "const original = $('Parse Gemini Output').first().json;\nconst uploadVoice = $('Google Drive: Upload Voiceover').first().json;\n\nreturn [{\n  json: {\n    runId: original.runId,\n    audioUrl: `https://drive.google.com/uc?export=download&id=${uploadVoice.id}`\n  }\n}];"
      },
      "id": "52c75715-f380-4cc7-aef1-7aa499519c43",
      "name": "Attach RunId to Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2912,
        -592
      ]
    },
    {
      "parameters": {
        "jsCode": "const merged = $input.first().json;\nconst scriptData = $('Parse Gemini Output').first().json;\n\nconst SCENE_SEC = 6;\nconst urls = (merged.imageUrls || []).slice(0, 5);\nconst total = SCENE_SEC * 5;\n\nconst elements = urls.map((url, i) => ({\n  type: 'image',\n  track: 1,\n  time: i * SCENE_SEC,\n  duration: SCENE_SEC,\n  source: url,\n  fit: 'cover',\n  width: '100%',\n  height: '100%',\n  animations: [\n    { time: 0, duration: SCENE_SEC, easing: 'linear', type: 'scale', scope: 'element', start_scale: '100%', end_scale: '112%', fade: false }\n  ]\n}));\n\nelements.push({\n  type: 'audio',\n  track: 2,\n  time: 0,\n  duration: total,\n  source: merged.audioUrl\n});\n\nelements.push({\n  type: 'text',\n  track: 3,\n  time: 0,\n  duration: 4,\n  text: scriptData.title || '',\n  x: '50%',\n  y: '12%',\n  width: '86%',\n  x_alignment: '50%',\n  y_alignment: '50%',\n  font_family: 'Montserrat',\n  font_weight: '800',\n  font_size: '6 vmin',\n  fill_color: '#ffffff',\n  stroke_color: '#000000',\n  stroke_width: '0.5 vmin',\n  animations: [{ time: 'end', duration: 0.5, easing: 'linear', type: 'fade', transition: true }]\n});\n\nconst source = {\n  output_format: 'mp4',\n  width: 1080,\n  height: 1920,\n  duration: total,\n  frame_rate: 30,\n  elements\n};\n\nreturn [{\n  json: {\n    source,\n    runId: scriptData.runId,\n    title: scriptData.title,\n    description: scriptData.description,\n    tags: scriptData.tags,\n    attempts: 0\n  }\n}];"
      },
